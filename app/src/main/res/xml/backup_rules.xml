<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for API < 31 (ignored on 31+, where data_extraction_rules
   applies). DataStore holds the trial checkpoint and subscription mirror and
   must not travel between devices — see data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
    <!-- The extracted Vosk model (~67 MB) is a copy of the APK asset, not user
         data. Including it pushes the app past Auto Backup's 25 MB cap, which
         silently cancels the whole backup — taking the learner's progress with it. -->
    <exclude domain="file" path="vosk/" />
</full-backup-content>
