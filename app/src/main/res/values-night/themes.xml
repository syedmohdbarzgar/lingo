<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Compose host — no ActionBar). -->
    <style name="Theme.English" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_400</item>
        <item name="colorPrimaryVariant">@color/primary_700</item>
        <item name="colorOnPrimary">@color/neutral_950</item>
        <item name="colorSecondary">@color/primary_300</item>
        <item name="colorSecondaryVariant">@color/primary_400</item>
        <item name="colorOnSecondary">@color/neutral_950</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/night_background</item>
    </style>

    <!-- Same bare brand launch as light mode: the brand color has no night
         override, so dark mode gets the identical blue field (no logo, 0ms)
         — no flash between the icon tap and the app. -->
    <style name="Theme.English.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_empty</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <!-- Same android-namespaced fallback as light mode: the starting window
             must be the brand blue in dark mode too (night colorBackground is
             black), with the same empty icon and 0ms. -->
        <item name="android:windowBackground" tools:targetApi="l">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/splash_icon_empty</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="s">0</item>
        <!-- Shared with light mode: after installSplashScreen() the activity window
             keeps the brand field instead of the night colorBackground (black). -->
        <item name="postSplashScreenTheme">@style/Theme.English.SplashHost</item>
    </style>
</resources>
