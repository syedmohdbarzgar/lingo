<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Compose host — no ActionBar). -->
    <style name="Theme.English" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_400</item>
        <item name="colorPrimaryVariant">@color/primary_700</item>
        <item name="colorOnPrimary">@color/neutral_950</item>
        <item name="colorSecondary">@color/primary_300</item>
        <item name="colorSecondaryVariant">@color/primary_400</item>
        <item name="colorOnSecondary">@color/neutral_950</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/night_background</item>
    </style>

    <!-- Same branded launch as light mode: the launcher icon is blue in dark
         mode too (no night override), so the splash field stays continuous with
         the tapped icon instead of flashing a different background first. -->
    <style name="Theme.English.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.English</item>
    </style>
</resources>
